# Copy to .env.local (never committed) and fill in. On your host, set the
# same variables in its environment settings. None of these are ever sent to
# the browser: do not rename them with a NEXT_PUBLIC_ prefix.

# Your live address, used for canonical URLs, the sitemap, social sharing
# and the invitation links in /admin. Set this before going live.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# MongoDB connection string (MongoDB Atlas: Database → Connect → Drivers).
# Required. Use a database user that can only access this site's database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=APP
# Database name inside the cluster. Defaults to "fusion".
MONGODB_DB=fusion

# Admin access code. Needed to create the first (super admin) account at
# /admin/register, and for further sign-ups while "Allow new accounts with
# the access code" is on (Administrators → Security). Use a long random
# value and change it if it is ever shared outside the team.
ADMIN_INVITE_SECRET=

# Google Search Console verification code (the content="" value of the meta tag).
GOOGLE_SITE_VERIFICATION=

# Hosted image storage. Only needed on serverless hosts; otherwise uploads
# are saved to .data/uploads. Cloudinary is used when all three are set
# (Cloudinary Dashboard → Settings → API Keys); uploads are signed on the
# server, so no upload preset is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Vercel Blob, used when Cloudinary is not configured.
BLOB_READ_WRITE_TOKEN=
